node_modules/
dist/
dist-firefox/
*.local
.env
.DS_Store
*.zip

# Published install packages are part of the release history and are mirrored to GitHub.
# Keep every zip under 插件版本/ tracked; all other zips (e.g. the upstream snapshot) stay ignored.
!插件版本/**/*.zip

# Internal working docs. Kept locally, not published to the public repo.
BRAND.md
CLAUDE.md
PUBLISHING-FIREFOX.md
QA_CHECKLIST.md
STORE_LISTING.md
TODO.md

# The private checkout those docs now live in, cloned to internal/ on each machine. Ignored
# as a whole, so nothing in it can be staged here, its own scaffolding included, not even
# on a fresh clone where its setup has not run yet.
internal/

# The listing copy STORE_LISTING.md points at: one file per language, plus the AMO
# submission fields. Submission notes rather than product source, and the reviewer-notes
# template has a line meant to be filled with the Google OAuth client secret at paste
# time, which must never reach a commit.
store-listing/

# Upstream Konode snapshot, kept locally for comparison and future compatibility work.
# The zip next to it is already covered by *.zip above.
konode-main/

# Local build leftovers embed absolute machine paths and don't belong in the repo.
vitest.config.ts.timestamp-*.mjs
vite.config.ts.timestamp-*.mjs

# WorkBuddy project memory embeds absolute local machine paths of the developer's
# machine. It is local-only working memory and must never be published.
.workbuddy/

# Misc local filesystem / network-volume artifacts that accumulate but carry no source.
.smbdelete*
node_modules.finder-alias.bak

# Machine-specific tool workspace and sandbox-test leftovers. These were previously
# only listed in .git/info/exclude (a LOCAL ignore that does not travel with the repo),
# so a `git add .` on a fresh clone could have committed them. Keep them in the shared
# ignore so every checkout is protected. .codebuddy/ is another AI tool's workspace and
# may hold local paths / conversation data; it must never reach the public repo.
.codebuddy/
zz-test.txt
.rm-test.txt
node_modules_testlink
